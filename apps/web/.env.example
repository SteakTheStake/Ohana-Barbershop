# Run `pnpm setup:local` to generate development credentials instead.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=file:./ohana.db
APP_URL=http://localhost:3000
# Optional separate owner domain; defaults to APP_URL for local development.
OWNER_APP_URL=http://localhost:3000
CMS_ADMIN_EMAIL=owner@example.com
CMS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Private meeting preview only. See docs/DEMO.md; never enable on the real site.
DEMO_MODE=false
DEMO_PASSWORD=spencerohana
# Ignored unless DEMO_MODE=true; must be a local file named ohana-demo.db.
DEMO_DATABASE_URL=file:./ohana-demo.db

# console is development-only; production requires twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Only enable behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional encrypted backup tooling (server-only; escrow separately).
# Generate 32 random bytes and encode as 64 hex characters. Never commit the key.
BACKUP_KEY=

# Optional Rosie/Google Calendar bridge. Read docs/ROSIE_INTEGRATION.md first.
# Keep disabled until a dedicated test calendar and scheduled sync are verified.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key, with newlines represented as \n inside a quoted value.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Unique per environment/database; retain across deployments (16+ characters).
GOOGLE_CALENDAR_NAMESPACE=
# Random 32+ character bearer secret for POST /api/calendar-sync.
GOOGLE_CALENDAR_SYNC_SECRET=
# Keep enabled in production; post-commit sync has scheduled recovery.
GOOGLE_CALENDAR_AUTO_SYNC=true
# link is the safe default: configure Rosie to text /book rather than confirm independently.
ROSIE_BOOKING_MODE=link
# Required ONLY for mode=calendar; acknowledges that Google cannot reserve atomically.
ROSIE_ACCEPT_NONATOMIC_BOOKINGS=false