{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "setup:local": "node scripts/setup-local.mjs",
    "typecheck": "tsc --noEmit",
    "payload": "node --env-file-if-exists=.env.local node_modules/payload/bin.js",
    "test": "tsx --expose-gc --test --test-concurrency=1 src/components/ocean-text.test.mjs src/lib/scheduling.test.ts src/lib/google-calendar.test.ts src/lib/transaction-effects.test.ts tests/google-calendar.integration.test.ts tests/calendar-worker.test.mjs tests/backup.test.mjs tests/booking.integration.test.ts tests/production.integration.test.ts tests/owner.integration.test.ts tests/demo.test.mjs tests/demo.integration.test.ts",
    "test:browser": "playwright test",
    "test:demo": "tsx --expose-gc --test --test-concurrency=1 tests/demo.test.mjs tests/demo.integration.test.ts",
    "cleanup:auth": "tsx --env-file-if-exists=.env.local scripts/cleanup-auth.ts",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "calendar:sync": "node --env-file-if-exists=.env.local scripts/calendar-sync.mjs",
    "calendar:health": "node --env-file-if-exists=.env.local scripts/calendar-sync.mjs --check"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "graphql": "16.13.2",
    "luxon": "3.7.2",
    "next": "16.3.3",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
